package docguard

func bindingExpect(ok: Bool, label: String): Unit {
    if (!ok) { throw Exception("FAIL bindings: " + label) }
}
main(): Int64 {
    let first = J.obj().put("id", J.str("s-first")).put("name", J.str("read")).put("package", J.str("demo")).put("owner", J.str("First"))
    let legacy = J.obj().put("symbol", J.str("read"))
    bindingExpect(!rSymbolMatch(first, legacy), "legacy short name must not acquire an identity in report")
    let second = parseJson(first.dump()).put("id", J.str("s-second")).put("owner", J.str("Second"))
    let symbols = J.arr().add(first).add(second)
    bindingExpect(resolveBinding(symbols, "read").get("status").s() == "AMBIGUOUS", "same name across owners")
    bindingExpect(resolveBinding(symbols, "demo.read").get("status").s() == "AMBIGUOUS", "package does not disambiguate owners")
    bindingExpect(resolveBinding(symbols, "First.read").get("symbol_id").s() == "s-first", "owner-qualified unique")
    bindingExpect(resolveBinding(symbols, "demo.Second.read").get("symbol_id").s() == "s-second", "fully-qualified unique")
    bindingExpect(resolveBinding(symbols, "missing").get("status").s() == "UNKNOWN", "unknown reference")
    let overload = parseJson(first.dump()).put("id", J.str("s-overload"))
    symbols.add(overload)
    bindingExpect(resolveBinding(symbols, "First.read").get("status").s() == "AMBIGUOUS", "overloaded member requires ID")
    bindingExpect(resolveBinding(symbols, "s-first").get("symbol_id").s() == "s-first", "exact ID selects overload")
    let crossFile = parseJson(second.dump()).put("id", J.str("s-other-file")).put("source", J.str("other.cj"))
    symbols.add(crossFile)
    bindingExpect(resolveBinding(symbols, "demo.Second.read").get("status").s() == "AMBIGUOUS", "cross-file same owner remains ambiguous")
    let unique = J.obj().put("id", J.str("s-unique")).put("name", J.str("unique")).put("package", J.str("demo")).put("owner", J.str(""))
    symbols.add(unique)
    bindingExpect(resolveBinding(symbols, "unique").get("symbol_id").s() == "s-unique", "unique short name compatible")
    bindingExpect(resolveBinding(symbols, "demo.unique").get("symbol_id").s() == "s-unique", "unique package name compatible")
    let example = J.obj().put("id", J.str("first-only")).put("symbol", J.str("s-first")).put("file", J.str("example.cj"))
    let examples = J.arr().add(example).add(parseJson(example.dump()).put("id", J.str("bad")).put("symbol", J.str("read")))
        .add(parseJson(example.dump()).put("id", J.str("unknown")).put("symbol", J.str("missing")))
    let configBefore = examples.dump()
    let api = J.obj().put("symbols", symbols).put("diagnostics", J.arr())
    bindExamples(api, examples)
    bindingExpect(examples.dump() == configBefore, "binding must not mutate fingerprinted configuration")
    bindingExpect(first.get("examples").items.size == 1 && second.get("examples").items.size == 0 && overload.get("examples").items.size == 0, "only exact identity gets example")
    bindingExpect(api.get("diagnostics").items.size == 2 && api.get("diagnostics").items[0].get("severity").s() == "error", "unknown and ambiguous error diagnostics")
    let resolved = resolveBinding(symbols, "s-first")
    let record = J.obj().put("symbol", J.str("s-first")).put("symbol_id", J.str("s-first")).put("binding_status", J.str("RESOLVED"))
    bindingExpect(bindingRecordCurrent(resolved, record), "persisted matching identity accepted")
    bindingExpect(!bindingRecordCurrent(resolved, legacy), "legacy success not rebound")
    bindingExpect(!bindingRecordCurrent(resolveBinding(symbols, "s-second"), record), "changed binding rejected")
    bindingExpect(!bindingRecordCurrent(resolveBinding(symbols, "read"), record), "ambiguous current catalog rejects old binding")
    bindingExpect(rSymbolMatch(first, record) && !rSymbolMatch(second, record) && !rSymbolMatch(overload, record), "report respects only persisted identity")
    let report = J.obj().put("api", api).put("results", J.arr().add(record.put("example_id", J.str("first-only"))))
    let html = rDefinitions(report)
    bindingExpect(html.split("href=\"#result-0\"").size == 2, "HTML renders one example association")
    println("PASS bindings: owners, overloads, cross-file, unknown, IDs, immutable config, historical records, report")
    return 0
}
